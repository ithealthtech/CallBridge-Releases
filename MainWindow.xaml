<Window x:Class="CallBridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CallBridge" Height="760" Width="1160" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#EDF6F8" Foreground="#16202A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#16202A"/>
        <SolidColorBrush x:Key="Muted" Color="#657789"/>
        <SolidColorBrush x:Key="Line" Color="#D5E4EB"/>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelSoft" Color="#F6FAFC"/>
        <SolidColorBrush x:Key="Brand" Color="#057AA8"/>
        <SolidColorBrush x:Key="Accent" Color="#34BEAA"/>
        <SolidColorBrush x:Key="Coral" Color="#FF7A70"/>
        <SolidColorBrush x:Key="Violet" Color="#6757D8"/>
        <DropShadowEffect x:Key="SoftShadow" Color="#88A7B4" BlurRadius="28" ShadowDepth="8" Opacity=".22"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E7F7F8"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#82CCD8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style x:Key="DialButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="82"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#F7FCFD"/>
            <Setter Property="BorderBrush" Value="#D3E7EE"/>
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#CFE1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFEFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="SoftListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RowItemTemplate">
            <Border BorderBrush="#D8E8EE" BorderThickness="1" CornerRadius="16" Padding="15" MinHeight="66">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F4FBFC" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="12" BorderBrush="#A9DAE1" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E6F9F7" Offset="0"/>
                                <GradientStop Color="#EAF2FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Brand}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Action}" Foreground="{StaticResource Brand}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="#CFE0E8" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F4FBFC" Offset=".54"/>
                    <GradientStop Color="#EEF7FA" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,6,0,26">
                    <Border CornerRadius="18" BorderBrush="#9BD4DD" BorderThickness="1" Padding="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#EAF7FF" Offset=".55"/>
                                <GradientStop Color="#EAFBF7" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="Assets/ithealthtech-logo.png" Height="42" Stretch="Uniform" HorizontalAlignment="Left"/>
                    </Border>
                    <StackPanel Margin="4,12,0,0">
                        <TextBlock x:Name="LogoText" Text="CB" Visibility="Collapsed"/>
                        <TextBlock x:Name="BrandTitle" Text="CALLBRIDGE" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="BrandSubtitle" Text="IT HEALTH TECHNOLOGIES" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" BorderBrush="#C7E2E8" BorderThickness="1" CornerRadius="16" Padding="13" Margin="0,0,0,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EEFBF8" Offset="0"/>
                            <GradientStop Color="#F5F7FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PresenceDot" Width="9" Height="9" Fill="{StaticResource Accent}" Margin="0,4,9,0"/>
                        <StackPanel>
                            <TextBlock x:Name="PresenceText" Text="Available" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="ExtensionText" Text="Extension 201" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2">
                    <Button x:Name="DashboardButton" Style="{StaticResource NavButton}" Content="Dashboard"/>
                    <Button x:Name="PhoneButton" Style="{StaticResource NavButton}" Content="Phone"/>
                    <Button x:Name="ContactsButton" Style="{StaticResource NavButton}" Content="Contacts"/>
                    <Button x:Name="HistoryButton" Style="{StaticResource NavButton}" Content="Call history"/>
                    <Button x:Name="MessagesButton" Style="{StaticResource NavButton}" Content="Messages"/>
                    <Button x:Name="VoicemailButton" Style="{StaticResource NavButton}" Content="Voicemail"/>
                    <Button x:Name="ParkingButton" Style="{StaticResource NavButton}" Content="Parking"/>
                    <Button x:Name="RecordingsButton" Style="{StaticResource NavButton}" Content="Recordings"/>
                    <Button x:Name="MspButton" Style="{StaticResource NavButton}" Content="MSP actions"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Content="Settings"/>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="PHONE STATUS" Foreground="{StaticResource Muted}" FontSize="9"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#DFAE4B" Margin="0,4,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Checking" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="CallBridge v0.6.4" Foreground="#8795A2" FontSize="10" Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="#D8E5EC" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F6FCFD" Offset=".58"/>
                        <GradientStop Color="#F1F4FF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="30,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Phone" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="White-label voice control center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox x:Name="ProviderBox" Width="176" Height="34"/>
                        <Button x:Name="RegisterButton" Content="Register" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="30">
                <Grid x:Name="PhoneView">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="#C7E5E9" BorderThickness="1" CornerRadius="15" Padding="11">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#EAFBF7" Offset="0"/>
                                        <GradientStop Color="#F2F5FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="CallStateText" Text="READY" Foreground="{StaticResource Brand}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="DialText" Grid.Row="1" TextAlignment="Center" FontSize="28" Margin="0,14,0,18" BorderThickness="0,0,0,1" FontWeight="SemiBold"/>
                            <UniformGrid x:Name="DialPad" Grid.Row="2" Columns="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource DialButton}" Content="1"/>
                                <Button Style="{StaticResource DialButton}" Content="2 ABC"/>
                                <Button Style="{StaticResource DialButton}" Content="3 DEF"/>
                                <Button Style="{StaticResource DialButton}" Content="4 GHI"/>
                                <Button Style="{StaticResource DialButton}" Content="5 JKL"/>
                                <Button Style="{StaticResource DialButton}" Content="6 MNO"/>
                                <Button Style="{StaticResource DialButton}" Content="7 PQRS"/>
                                <Button Style="{StaticResource DialButton}" Content="8 TUV"/>
                                <Button Style="{StaticResource DialButton}" Content="9 WXYZ"/>
                                <Button Style="{StaticResource DialButton}" Content="*"/>
                                <Button Style="{StaticResource DialButton}" Content="0 +"/>
                                <Button Style="{StaticResource DialButton}" Content="#"/>
                            </UniformGrid>
                            <Button x:Name="CallButton" Grid.Row="3" Content="Call" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Padding="15" Margin="0,18,0,0">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#31C29F" Offset="0"/>
                                        <GradientStop Color="#067EAF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                            <UniformGrid Grid.Row="4" Columns="4" Margin="0,10,0,0">
                                <Button x:Name="MuteButton" Content="Mute" Margin="3"/>
                                <Button x:Name="HoldButton" Content="Hold" Margin="3"/>
                                <Button x:Name="TransferButton" Content="Transfer" Margin="3"/>
                                <Button x:Name="DtmfButton" Content="DTMF" Margin="3"/>
                            </UniformGrid>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelBorder}" Padding="22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Registration" Foreground="{StaticResource Muted}" FontSize="10"/>
                                    <TextBlock x:Name="RegistrationMetric" Text="Not registered" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Active call" Foreground="{StaticResource Muted}" FontSize="10"/>
                                    <TextBlock x:Name="ActiveCallMetric" Text="None" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Connector API" Foreground="{StaticResource Muted}" FontSize="10"/>
                                    <TextBlock x:Name="ApiMetric" Text="Unknown" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="PanelHeading" Text="Favorites" FontWeight="SemiBold" FontSize="18"/>
                                <ListBox x:Name="MainList" Grid.Row="1" Margin="0,14,0,0" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource RowItemTemplate}" ItemContainerStyle="{StaticResource SoftListItem}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <Grid x:Name="ListView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock x:Name="ListHeading" Text="Contacts" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ListSubheading" Text="People and extensions" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280" Height="38" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="18">
                        <ListBox x:Name="RowsList" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource RowItemTemplate}" ItemContainerStyle="{StaticResource SoftListItem}"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
