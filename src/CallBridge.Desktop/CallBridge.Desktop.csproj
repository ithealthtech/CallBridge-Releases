<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.15.0</Version>
    <AssemblyVersion>0.15.0.0</AssemblyVersion>
    <FileVersion>0.15.0.0</FileVersion>
    <Product>CallBridge Softphone</Product>
    <Company>IT Health Technologies</Company>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\ithealthtech-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\IBM-Plex-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.16" />
  </ItemGroup>

</Project>
